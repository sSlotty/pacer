# Copy to .env (git-ignored) for local runs:  cp .env.example .env
DISCORD_WEBHOOK_URL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Order to try LLMs, comma-separated (providers without a key are skipped)
LLM_PROVIDER=anthropic,openai
# CLAUDE_MODEL=claude-sonnet-5
# OPENAI_MODEL=gpt-5.4-mini
# Weather forecast location (defaults to where your last outdoor run started) and run start time
# WEATHER_LAT=13.75
# WEATHER_LON=100.50
# RUN_TIME=07:00
# RACES=[{"name":"Uthai Trail 2026","type":"trail","date":"2026-12-05","distance_km":50,"elevation_m":2500,"priority":"A"}]
